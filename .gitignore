.cursor/worktrees/

# --- Adapter projections: generated, never source (VCS policy decided 2026-07-29) ---
# Every path below is reproduced byte-for-byte from tracked sources under agent_collab/adapters/
# by Project-ClaudeAdapter.ps1 / Project-GrokAdapter.ps1. Same rule as procedural/reports/ (:54):
# deterministic regenerable output is not committed. The source of truth is agent_collab/adapters/.
#
# Post-clone, run BOTH projections or the runtime has no hook registration and every Bash call
# runs unguarded:
#   pwsh -NoProfile -File agent_collab/scripts/Project-ClaudeAdapter.ps1
#   pwsh -NoProfile -File agent_collab/scripts/Project-GrokAdapter.ps1
# Test-AgentCollabScaffold.ps1 verifies the tracked source carries the PreToolUse Bash
# registration and that any existing projection has not drifted from it.
.claude/agents/
.claude/commands/
.claude/hooks/
.claude/settings.json
.grok/agents/
.grok/rules/
.grok/skills/
.grok/runner_config.json

# Session scratch written by agents at runtime, not source.
.claude/handoffs/

# Vendored third-party skill content. Provenance + digests live in the tracked skills-lock.json,
# which is the record that makes these reacquirable; the payloads themselves are not committed.
.claude/skills/
.agents/

# Written by the NeoStackAI plugin, which is itself local-only (see Plugins/NeoStackAI/ below).
.neostack/

# Environment secrets — API keys, DB URL, GH_TOKEN/GITHUB_TOKEN. NEVER commit.
.env
.env.*
!.env.example

# Local agent settings — may hold secrets (e.g. GH_TOKEN/GITHUB_TOKEN). NEVER commit.
.claude/settings.local.json
.grok/settings.local.json

# Agent collaboration volatile runtime state only (core protocol + scripts + context + registry + durable handoffs/outbox/state are committed and shared)
agent_collab/state/orchestrator.lock
agent_collab/logs/orchestrator.log

# Note: AGENTS.md and docs/CollaborationSystem-Phase2-Design.md are now tracked as they document the system.
# All agent_collab/ except the volatile paths above must be committed for the collab protocol to be usable after clone.
# (See agent_collab/ source of truth, test in Test-AgentCollabScaffold.ps1)

# Do NOT ignore these:
# Config/
# Content/
# Plugins/
# Source/
# *.uproject

# GloamsteadForge emitted runtime evidence (regenerated by the evidence emitter test; not source)
procedural/reports/

# Imported third-party / vendored content — large binary Megascans foliage (~24 GB), re-importable from Fab.
# Kept local only; NOT committed to plain-git history (decided 2026-07-20). Re-acquire from the source packs.
Content/BlackAlder/
Content/CommonHazel/
Content/EuropeanHornbeam/
Content/MSPresets/

# Third-party / local-tooling plugins — kept local only (decided 2026-07-20).
# NeoStackAI = local agent bridge (Fab marketplace); CoreTerrainMaterials = marketplace terrain plugin.
# WorldForge (project-authored) is committed; its Binaries/Intermediate are covered by the global rules above.
Plugins/NeoStackAI/
# Same install, descriptor renamed aside so UnrealBuildTool sees only the engine copy: the
# project-local v3.1.25 self-installed on 2026-08-06 shipping Source/ without its ThirdParty
# Lua/sol2 headers, which fails UBT at makefile creation. Restore by renaming both back.
Plugins/NeoStackAI.disabled/
Plugins/CoreTerrainMaterials/

# Regenerated by the editor on every launch (Broadcast/DMX device discovery); not authored.
Config/BroadcastDeviceProviderRegistry.json

# Cycle 5 / local run scratch artifacts (never source)
.ue-local-cycle5/
.tmp_cycle5_focused_test.cmd

# Engine plugin scaffold dropped into the project root by PixelStreaming2
/Samples/

# Python bytecode
__pycache__/
*.pyc

# WorldForge bridge output (generated; reproducible from spec + schema + compiler)
/artifacts/
