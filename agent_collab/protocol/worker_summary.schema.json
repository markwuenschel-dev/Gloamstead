{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkerSummary",
  "type": "object",
  "properties": {
    "request_id": { "type": "string" },
    "task_id": { "type": "string" },
    "role": { "type": "string" },
    "runtime": { "type": "string" },
    "instance_id": { "type": "string" },
    "verdict": { "type": "string", "enum": ["DONE", "APPROVED", "REJECTED", "BLOCKED", "DOCS_BLOCKED"] },
    "summary": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "criteria_results": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "branch": { "type": ["string", "null"] },
    "worktree_path": { "type": ["string", "null"] },
    "base_commit": { "type": ["string", "null"] },
    "head_commit": { "type": ["string", "null"] },
    "risks": { "type": "array", "items": { "type": "string" } },
    "needs": { "type": ["array", "null"], "items": { "type": "string" } },
    "blocker": { "type": ["string", "null"] },
    "raw_output_path": { "type": ["string", "null"] }
  },
  "required": ["request_id", "task_id", "role", "runtime", "instance_id", "verdict", "summary"]
}
