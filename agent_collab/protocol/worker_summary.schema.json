{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkerSummary",
  "type": "object",
  "properties": {
    "task_id": { "type": "string" },
    "task_type": { "type": "string" },
    "slice_id": { "type": ["string", "null"] },
    "runtime": { "type": "string" },
    "changed_text_files": { "type": "array", "items": { "type": "string" } },
    "generated_binary_files": { "type": "array", "items": { "type": "string" } },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "verification_run": { "type": "array", "items": { "type": "string" } },
    "verification_results": { "type": "object" },
    "asset_pack_ids_used": { "type": "array", "items": { "type": "string" } },
    "unresolved_risks": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria_status": { "type": "object" },
    "requires_human_playtest": { "type": "boolean" },
    "human_playtest_status": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "required": ["task_id", "task_type", "runtime"]
}