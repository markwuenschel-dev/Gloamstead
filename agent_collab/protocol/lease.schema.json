{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lease",
  "type": "object",
  "properties": {
    "lease_id": { "type": "string" },
    "task_id": { "type": "string" },
    "request_id": { "type": "string" },
    "role": { "type": "string" },
    "runtime": { "type": "string" },
    "instance_id": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "completed", "expired", "released", "failed"] },
    "created": { "type": "string" },
    "heartbeat": { "type": "string" },
    "expires": { "type": "string" }
  },
  "required": ["lease_id", "task_id", "request_id", "role", "runtime", "instance_id", "status", "created", "heartbeat", "expires"]
}
