{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SchedulerState",
  "type": "object",
  "properties": {
    "mode": { "type": "string" },
    "dag": { "type": ["object", "null"] },
    "waves": { "type": "array", "items": { "type": "object" } },
    "max_parallel": { "type": "integer" },
    "work_branch": { "type": "string" },
    "in_flight": { "type": "array", "items": { "type": "string" } },
    "ready_queue": { "type": "array", "items": { "type": "string" } },
    "blocked": { "type": "array", "items": { "type": "string" } },
    "completed": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["mode", "waves", "max_parallel", "work_branch", "in_flight", "ready_queue", "blocked", "completed"]
}