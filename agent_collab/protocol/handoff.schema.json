{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Handoff",
  "type": "object",
  "properties": {
    "handoff_id": { "type": "string" },
    "task_id": { "type": "string" },
    "task_type": { "type": "string" },
    "slice_id": { "type": ["string", "null"] },
    "role": { "type": "string" },
    "from": { "type": "string" },
    "to": { "type": ["string", "null"] },
    "selected_runtime": { "type": ["string", "null"] },
    "allowed_runtimes": { "type": "array", "items": { "type": "string" } },
    "preferred_runtime": { "type": ["string", "null"] },
    "created": { "type": "string" },
    "status": { "type": "string", "enum": ["claimed", "done", "blocked", "archived"] },
    "goal": { "type": "string" },
    "context": { "type": ["string", "null"] },
    "asset_pack_ids": { "type": "array", "items": { "type": "string" } },
    "file_ownership": { "type": "array", "items": { "type": "string" } },
    "generated_output_ownership": { "type": "array", "items": { "type": "string" } },
    "content_policy": { "type": ["object", "null"] },
    "required_capabilities": { "type": "array", "items": { "type": "string" } },
    "required_verification_profiles": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "docs_impact": { "type": "boolean" },
    "requires_unreal_editor": { "type": "boolean" },
    "requires_human_playtest": { "type": "boolean" },
    "input_artifacts": { "type": "array", "items": { "type": "string" } },
    "output_artifacts": { "type": "array", "items": { "type": "string" } },
    "runtime_notes": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "worktree_path": { "type": ["string", "null"] },
    "changed_text_files": { "type": "array", "items": { "type": "string" } },
    "generated_binary_files": { "type": "array", "items": { "type": "string" } },
    "verdict": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "history": { "type": "array", "items": { "type": "object" } }
  },
  "required": ["handoff_id", "task_id", "task_type", "role", "status", "goal"]
}