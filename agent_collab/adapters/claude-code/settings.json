{
  "worktree": { "baseRef": "head" },
  "hooks": {
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "pwsh", "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/agent_collab/adapters/claude-code/hooks/pre-bash-policy.ps1"], "shell": "powershell", "timeout": 15 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "pwsh", "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/agent_collab/adapters/claude-code/hooks/log-subagent-event.ps1"], "shell": "powershell", "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "pwsh", "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/agent_collab/adapters/claude-code/hooks/log-subagent-event.ps1"], "shell": "powershell", "timeout": 5 }] }]
  },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(Remove-Item -Recurse:*)"
    ]
  }
}
