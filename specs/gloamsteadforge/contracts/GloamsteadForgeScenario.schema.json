{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "GloamsteadForge/Scenario/v1",
  "title": "GloamsteadForgeScenario",
  "description": "One entry in the scenario matrix: what runtime behavior is expected and where its evidence lives.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "night_type", "expected_outcome", "objective_bearing", "continuity", "quiet", "report"],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "night_type": { "type": "string", "enum": ["Invalid", "Tutorial", "Corruption", "Omen", "Retrieval", "SilencePossession", "Mirror", "Bargain", "Fracture", "TrueSiege"] },
    "expected_outcome": { "type": "string", "enum": ["None", "Success", "Partial", "Failure"] },
    "objective_bearing": { "type": "boolean" },
    "continuity": { "type": "boolean" },
    "quiet": { "type": "boolean" },
    "report": { "type": "string", "minLength": 1, "description": "Path (repo-relative) to the emitted runtime report for this scenario." }
  }
}
