{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "GloamsteadForge/PCGInitProof/v1",
  "title": "PCGInitProof",
  "description": "Evidence that the PCG sanctuary state initialized with real points.",
  "type": "object",
  "additionalProperties": false,
  "required": ["initialized", "point_count"],
  "properties": {
    "initialized": { "type": "boolean" },
    "point_count": { "type": "integer", "minimum": 0 }
  }
}
